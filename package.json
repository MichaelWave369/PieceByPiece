{
  "name": "piece-by-piece",
  "version": "0.3.0",
  "private": true,
  "description": "Peaceful XR architectural puzzle adventure with optional asynchronous city pack sharing",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "validate:packs": "node scripts/validate-community.mjs community/packs game/campaign/the-living-block.json",
    "check": "npm test && npm run validate:packs",
    "validate:systems": "node --test tests/city-systems.test.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
